<Project>

  <!--
    Shared MSBuild settings for every UsageBar Windows project.

    This file is scoped to `windows/` on purpose: the macOS SwiftPM build at the
    repository root is completely independent and must never be affected by it.
  -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NeutralLanguage>en</NeutralLanguage>
    <Product>UsageBar</Product>
    <Company>UsageBar</Company>
    <Copyright>UsageBar contributors</Copyright>
    <Version>2.0.1</Version>
    <AssemblyVersion>2.0.1.0</AssemblyVersion>
    <FileVersion>2.0.1.0</FileVersion>
    <!-- No telemetry, no crash reporting, no third-party runtime dependencies. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
