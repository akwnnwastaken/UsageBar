<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tray-only WPF application. WinExe (not Exe) so no console window is ever
    created, and Windows Forms interop is enabled purely for NotifyIcon, which
    WPF has no equivalent of.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>UsageBar</AssemblyName>
    <RootNamespace>UsageBar.Windows.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Explicit entry point: there is no App.xaml, so WPF generates none. -->
    <StartupObject>UsageBar.Windows.App.Program</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!--
      WFAC010 asks for DPI to be configured through the Windows Forms
      ApplicationHighDpiMode property. This is a WPF application that only uses
      Windows Forms for NotifyIcon, and WPF reads PerMonitorV2 awareness from
      the manifest, so the manifest stays authoritative.
    -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UsageBar.Windows.Core\UsageBar.Windows.Core.csproj" />
    <ProjectReference Include="..\UsageBar.Windows.Infrastructure\UsageBar.Windows.Infrastructure.csproj" />
  </ItemGroup>

</Project>
